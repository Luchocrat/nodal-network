# Copy to .env.local (never commit .env.local). Server-only — never prefix with NEXT_PUBLIC_.
# Get a key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Gemma 4 IDs listed by Google for the Gemini API: gemma-4-26b-a4b-it, gemma-4-31b-it
GEMMA_MODEL=gemma-4-26b-a4b-it
